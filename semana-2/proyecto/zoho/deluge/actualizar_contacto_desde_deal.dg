/*
 * Función: actualizarContactoDesdeDeal
 * Módulo disparador: Deals (Tratos)
 * Cuándo se ejecuta: Workflow "Al crear un Deal" -> Acción "Función"
 *
 * Qué hace:
 *   Cuando se crea un Deal, busca el Contact asociado y le actualiza dos
 *   campos personalizados con la información del Deal:
 *     - Ultimo_Deal        (Línea única)  -> nombre del Deal
 *     - Monto_ultimo_Deal  (Moneda)       -> monto del Deal
 *
 * Argumento (se mapea en el workflow):
 *   dealId  ->  Deals.Deal Id
 */
void automation.actualizarContactoDesdeDeal(String dealId)
{
	// 1. Traer el Deal completo
	deal = zoho.crm.getRecordById("Deals", dealId.toLong());
	info "Deal leído: " + deal.get("Deal_Name");

	// 2. Revisar que el Deal tenga un Contact asociado
	contacto = deal.get("Contact_Name");
	if(contacto == null)
	{
		info "El Deal no tiene Contact asociado. No se actualiza nada.";
		return;
	}
	contactId = contacto.get("id");

	// 3. Armar los datos a actualizar en el Contact
	datos = Map();
	datos.put("Ultimo_Deal", deal.get("Deal_Name"));
	datos.put("Monto_ultimo_Deal", deal.get("Amount"));

	// 4. Actualizar el Contact y dejar registro de la respuesta
	respuesta = zoho.crm.updateRecord("Contacts", contactId.toLong(), datos);
	info "Respuesta de actualización: " + respuesta;
}
