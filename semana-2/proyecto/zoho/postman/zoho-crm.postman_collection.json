  "item": [
    {
      "name": "OAuth",
      "item": [
        {
          "name": "1. Generar tokens (grant code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Zoho devolvió access_token y refresh_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.expect(json).to.have.property('refresh_token');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.environment.set('access_token', json.access_token);",
                  "  pm.environment.set('refresh_token', json.refresh_token);",
                  "  pm.environment.set('token_expires_at', Date.now() + (json.expires_in || 3600) * 1000);",
                  "  if (json.api_domain) pm.environment.set('api_domain', json.api_domain);",
                  "  // El grant code solo sirve una vez: se limpia para no reutilizarlo",
                  "  pm.environment.set('grant_code', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "code",
                  "value": "{{grant_code}}"
                }
              ]
            },
            "url": {
              "raw": ""
            },
            "description": "Cambia el grant code (generado en el Self Client, dura pocos minutos y sirve una sola vez) por access_token + refresh_token."
          },
          "response": []
        },
        {
          "name": "2. Renovar access_token (manual)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token renovado', () => pm.expect(pm.response.json()).to.have.property('access_token'));",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.environment.set('access_token', json.access_token);",
                  "  pm.environment.set('token_expires_at', Date.now() + (json.expires_in || 3600) * 1000);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "url": {
              "raw": ""
            },
            "description": "No hace falta usarla: la colección renueva sola el token antes de cada petición. Está aquí para probar el flujo a mano."
          },
