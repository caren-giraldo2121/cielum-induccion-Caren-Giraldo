{
  "info": {
    "_postman_id": "a75d0f5a-b418-4b40-9b9c-fb720fbb5191",
    "name": "zoho-crm",
    "description": "Colección de práctica Zoho CRM (Cielum). Sin tokens reales: todo usa variables del entorno 'zoho-crm'. La renovación del access_token es automática (script de la colección).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "Zoho-oauthtoken {{access_token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Renovación AUTOMÁTICA del access_token con el refresh_token.",
          "// Se ejecuta antes de cada petición de la colección (excepto las de /oauth/v2/token).",
          "const esPeticionDeToken = pm.request.url.toString().includes('/oauth/v2/token');",
          "",
          "if (!esPeticionDeToken) {",
          "  const token = pm.environment.get('access_token');",
          "  const expira = Number(pm.environment.get('token_expires_at') || 0);",
          "  // Se renueva si no hay token o si vence en menos de 1 minuto",
          "  const vencido = !token || Date.now() > expira - 60000;",
          "",
          "  if (vencido) {",
          "    const refresh = pm.environment.get('refresh_token');",
          "    if (!refresh) {",
          "      console.warn('No hay refresh_token. Ejecuta primero \"OAuth > 1. Generar tokens (grant code)\".');",
          "    } else {",
          "      pm.sendRequest({",
          "        url: pm.environment.get('accounts_url') + '/oauth/v2/token',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "          mode: 'urlencoded',",
          "          urlencoded: [",
          "            { key: 'grant_type', value: 'refresh_token' },",
          "            { key: 'client_id', value: pm.environment.get('client_id') },",
          "            { key: 'client_secret', value: pm.environment.get('client_secret') },",
          "            { key: 'refresh_token', value: refresh }",
          "          ]",
          "        }",
          "      }, (err, res) => {",
          "        if (err) { console.error('Error renovando el token:', err); return; }",
          "        const json = res.json();",
          "        if (json.access_token) {",
          "          pm.environment.set('access_token', json.access_token);",
          "          pm.environment.set('token_expires_at', Date.now() + (json.expires_in || 3600) * 1000);",
          "          console.log('access_token renovado automáticamente');",
          "        } else {",
          "          console.error('Zoho no devolvió access_token:', json);",
          "        }",
          "      });",
          "    }",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "OAuth",
      "item": [
        {
          "name": "1. Generar tokens (grant code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Zoho devolvió access_token y refresh_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.expect(json).to.have.property('refresh_token');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.environment.set('access_token', json.access_token);",
                  "  pm.environment.set('refresh_token', json.refresh_token);",
                  "  pm.environment.set('token_expires_at', Date.now() + (json.expires_in || 3600) * 1000);",
                  "  if (json.api_domain) pm.environment.set('api_domain', json.api_domain);",
                  "  // El grant code solo sirve una vez: se limpia para no reutilizarlo",
                  "  pm.environment.set('grant_code', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "code",
                  "value": "{{grant_code}}"
                }
              ]
            },
            "url": {
              "raw": "{{accounts_url}}/oauth/v2/token"
            },
            "description": "Cambia el grant code (generado en el Self Client, dura pocos minutos y sirve una sola vez) por access_token + refresh_token."
          }
        },
        {
          "name": "2. Renovar access_token (manual)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token renovado', () => pm.expect(pm.response.json()).to.have.property('access_token'));",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.environment.set('access_token', json.access_token);",
                  "  pm.environment.set('token_expires_at', Date.now() + (json.expires_in || 3600) * 1000);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                }
              ]
            },
            "url": {
              "raw": "{{accounts_url}}/oauth/v2/token"
            },
            "description": "No hace falta usarla: la colección renueva sola el token antes de cada petición. Está aquí para probar el flujo a mano."
          }
        }
      ]
    },
