      "notes": "Upsert: si el Email ya existe en Zoho lo actualiza, si no lo crea (evita el retraso del índice de búsqueda)."
    },
    {
      "parameters": {
        "jsCode": "// Arma la fila para log_integraciones cuando Zoho respondió bien\nconst v = $('Validar pedido').first().json;\nconst r = $input.first().json;\nconst detalle = (r.data && r.data[0]) || {};\n\n// Fue actualizado si: la búsqueda lo encontró (nodo Actualizar contacto)\n// o el upsert respondió action = 'update' (ya existía, pero la búsqueda aún no lo veía)\nconst fueActualizado = $('Actualizar contacto').isExecuted || detalle.action === 'update';\n\nreturn [{\n  json: {\n    flujo: 'pedido-a-zoho',\n    id_pedido: v.id_pedido,\n    email_cliente: v.cliente.email,\n    accion: fueActualizado ? 'actualizado' : 'creado',\n    estado: 'exito',\n    id_zoho: detalle.details ? String(detalle.details.id) : null,\n    mensaje: fueActualizado\n      ? 'El contacto ya existía en Zoho y se actualizó con el último pedido'\n      : 'El contacto no existía en Zoho y se creó',\n    payload: JSON.stringify(v.payload)\n  }\n}];"
      },
      "id": "be029d7f-5bc6-434b-9e59-518f5b5c0088",
      "name": "Preparar log éxito",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// El pedido no pasó la validación: se registra y se avisa, pero no se toca Zoho\nconst v = $input.first().json;\nreturn [{\n  json: {\n    flujo: 'pedido-a-zoho',\n    id_pedido: Number.isInteger(v.id_pedido) ? v.id_pedido : null,\n    email_cliente: v.cliente?.email || null,\n    accion: 'rechazado',\n    estado: 'error',\n    id_zoho: null,\n    mensaje: 'Validación fallida: ' + v.errores.join('; '),\n    payload: JSON.stringify(v.payload || {})\n  }\n}];"
      },
      "id": "28a3242a-8f86-405f-a79a-f06302da2b43",
      "name": "Preparar log rechazado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Llega aquí cuando falla una llamada a Zoho (salida de error de los nodos HTTP)\nconst e = $input.first().json;\nlet v = {};\ntry { v = $('Validar pedido').first().json; } catch (err) { v = {}; }\n\n// n8n deja el error en distintos lugares según el nodo\nlet mensaje = e?.error?.message || e?.error?.description || e?.message || e?.error || e;\nif (typeof mensaje !== 'string') mensaje = JSON.stringify(mensaje);\n\nreturn [{\n  json: {\n    flujo: 'pedido-a-zoho',\n    id_pedido: v.id_pedido ?? null,\n    email_cliente: v.cliente?.email || null,\n    accion: 'error',\n    estado: 'error',\n    id_zoho: null,\n    mensaje: 'Error hablando con Zoho: ' + mensaje.slice(0, 1000),\n    payload: JSON.stringify(v.payload || {})\n  }\n}];"
      },
      "id": "321854f3-5056-40f5-9da9-058435ac9b23",
      "name": "Preparar log error",
