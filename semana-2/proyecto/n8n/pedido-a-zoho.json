    {
      "parameters": {
        "jsCode": "// Valida el pedido que envía la API (POST /pedidos -> webhook)\nconst entrada = $input.first().json;\nconst body = entrada.body || {};\nconst headers = entrada.headers || {};\nconst errores = [];\n\n// 1) Token compartido entre la API y n8n (evita que cualquiera llame al webhook)\nlet tokenEsperado = '';\ntry { tokenEsperado = $env.N8N_WEBHOOK_TOKEN || ''; } catch (e) { tokenEsperado = ''; }\nif (tokenEsperado && headers['x-cielum-token'] !== tokenEsperado) {\n  errores.push('Token del webhook inválido o ausente (header x-cielum-token)');\n}\n\n// 2) Estructura mínima del pedido\nconst pedido = body.pedido || {};\nconst cliente = body.cliente || {};\nconst detalles = Array.isArray(body.detalles) ? body.detalles : [];\nconst email = String(cliente.email || '').trim().toLowerCase();\n\nif (body.evento !== 'pedido.creado') errores.push('Evento desconocido: ' + body.evento);\nif (!Number.isInteger(pedido.id_pedido)) errores.push('Falta pedido.id_pedido');\nif (!cliente.nombre) errores.push('Falta el nombre del cliente');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errores.push('Correo del cliente inválido: \"' + email + '\"');\nif (detalles.length === 0) errores.push('El pedido no tiene detalles');\n\nconst total = Number(body.total) || 0;\nconst fecha = String(pedido.fecha_pedido || '').slice(0, 10);\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    errores,\n    id_pedido: pedido.id_pedido ?? null,\n    estado_pedido: pedido.estado ?? null,\n    fecha_pedido: fecha,\n    total,\n    cliente: { ...cliente, email },\n    // Datos listos para Zoho (Last_Name es obligatorio en Contacts)\n    zoho: {\n      Last_Name: cliente.nombre || 'Sin nombre',\n      Email: email,\n      Phone: cliente.telefono || null,\n      Description: `Último pedido Cielum #${pedido.id_pedido} · ${pedido.estado} · ${fecha} · total $${total.toLocaleString('es-CO')}`\n    },\n    payload: body\n  }\n}];"
      },
